#!/usr/bin/env bash
#
# Wallpaper helper for wpaperd.
#
#   dot-wallpaper next | prev       change wallpaper (says so when there is nothing to change to)
#   dot-wallpaper set <image>       show exactly this image (rotation stops until `rotate`)
#   dot-wallpaper rotate            go back to rotating through the whole folder
#   dot-wallpaper list              print every image wpaperd can show, one path per line
#   dot-wallpaper state             current image, rotating or pinned, theme mode and style
#   dot-wallpaper theme [mode dark|light] [style NAME]
#                                   colour scheme for matugen; styles: tonal-spot expressive
#                                   fidelity content neutral monochrome rainbow fruit-salad
#   dot-wallpaper doctor            explain why the wallpaper is black or won't change
#   dot-wallpaper init [--force] [--no-restart]
#                                   create ~/.config/wpaperd/config.toml if it's missing, put
#                                   the bundled wallpapers in ~/Pictures/Wallpapers if that
#                                   folder has fewer than two, and restart wpaperd
#   dot-wallpaper -h                this message
#
# How it fits together: wpaperd draws the wallpaper and rotates through the images in the
# `path` of its config. Each time it changes one it runs the `exec` script
# (~/.config/wpaperd/matugen-hook.sh), and that regenerates every colour in the desktop.
# So: no config, an empty folder or a single image = nothing to change to = colours never move.
#
# Environment: DOT_WALLPAPER_DIR overrides the folder used by `init`.

set -uo pipefail

config_dir="${XDG_CONFIG_HOME:-$HOME/.config}"
cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}"
CFG="$config_dir/wpaperd/config.toml"
HOOK="$config_dir/wpaperd/matugen-hook.sh"
WDIR="${DOT_WALLPAPER_DIR:-${XDG_PICTURES_DIR:-$HOME/Pictures}/Wallpapers}"

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/dot-wallpaper"
THEME_CONF="$STATE_DIR/theme.conf"      # read by wpaperd/matugen-hook.sh
FOLDER_FILE="$STATE_DIR/folder"         # the folder to rotate through, remembered while an image is pinned
STYLES=(tonal-spot expressive fidelity content neutral monochrome rainbow fruit-salad)

have() { command -v "$1" >/dev/null 2>&1; }
say()  { printf '%s\n' "$*"; }
warn() { printf 'warn: %s\n' "$*" >&2; }
die()  { printf 'error: %s\n' "$*" >&2; exit 1; }

# The bundled wallpapers: next to a checkout (run from the repo, or a --link install through the
# ~/.local/bin symlink), else the copy a normal install keeps in ~/.local/share/hyprdot.
bundle_dir() {
    local self root d
    self="$(readlink -f "${BASH_SOURCE[0]}")"
    root="$(cd "$(dirname "$self")/.." && pwd)"
    for d in "$root/wallpapers" "${XDG_DATA_HOME:-$HOME/.local/share}/hyprdot/wallpapers"; do
        [ -d "$d" ] && { printf '%s\n' "$d"; return 0; }
    done
    return 1
}

# count_images <dir-or-file>
count_images() {
    local p="$1"
    if [ -d "$p" ]; then
        find -L "$p" -maxdepth 1 -type f \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' -o -iname '*.bmp' \) 2>/dev/null | grep -c .
    elif [ -f "$p" ]; then
        echo 1
    else
        echo 0
    fi
}

# Every `path = ...` in the config, with ~ and $HOME expanded.
config_paths() {
    [ -s "$CFG" ] || return 0
    grep -E '^[[:space:]]*path[[:space:]]*=' "$CFG" \
        | sed -E 's/^[^=]*=[[:space:]]*//; s/[[:space:]]*(#.*)?$//; s/^"//; s/"$//' \
        | while IFS= read -r p; do
            p="${p/#\~/$HOME}"; p="${p//\$HOME/$HOME}"
            printf '%s\n' "$p"
        done
}

total_images() {
    local p n=0 c
    while IFS= read -r p; do
        c="$(count_images "$p")"; n=$((n + c))
    done < <(config_paths | sort -u)
    echo "$n"
}

# ---------------------------------------------------------------- next / prev
# A wallpaper picked in the picker (or with `set`) is PINNED: wpaperd's `path` is one file, so
# its own next/previous have nothing to rotate through. Step through the folder instead.
step_pinned() {   # step_pinned next-wallpaper|previous-wallpaper
    local cur i=-1 idx n list=()
    cur="$(readlink -f -- "$(config_paths | head -n 1)" 2>/dev/null)"
    mapfile -t list < <(list_images)
    n=${#list[@]}
    [ "$n" -ge 2 ] || die "only $n image(s) in $(rotation_folder) - add more wallpapers there (or run: dot-wallpaper init)"
    for idx in "${!list[@]}"; do
        if [ "$(readlink -f -- "${list[$idx]}")" = "$cur" ]; then i=$idx; break; fi
    done
    if [ "$1" = next-wallpaper ]; then
        i=$(( (i + 1) % n ))
    elif [ "$i" -lt 0 ]; then
        i=$(( n - 1 ))
    else
        i=$(( (i - 1 + n) % n ))
    fi
    cmd_set "${list[$i]}"
}

change() {   # change next-wallpaper|previous-wallpaper
    have wpaperctl || die "wpaperctl not found (it ships with wpaperd)"
    wpaperd_running || die "wpaperd is not running. Start it: setsid -f wpaperd -d   (or run: dot-wallpaper doctor)"
    local first; first="$(config_paths | head -n 1)"
    if [ -n "$first" ] && [ -f "$first" ]; then
        step_pinned "$1"
        return
    fi
    local n; n="$(total_images)"
    if [ "$n" -lt 2 ]; then
        warn "wpaperd only has $n image(s) to show, so there is nothing to change to. Add more to $(rotation_folder) (or run: dot-wallpaper init)"
    fi
    wpaperctl "$1"
}

# ---------------------------------------------------------------- doctor
doctor() {
    local problems=0 p n total=0 exec_line
    note() { say "  - $*"; problems=$((problems + 1)); }

    say "== wpaperd =="
    if have wpaperd; then say "  installed: $(command -v wpaperd)"; else note "wpaperd is not installed"; fi
    if wpaperd_running; then say "  running: pid $(pgrep -x wpaperd | head -1)"; else note "wpaperd is not running (setsid -f wpaperd -d)"; fi
    have wpaperctl || note "wpaperctl not found - the next/previous keys and menu entries can't work"

    say; say "== config: $CFG =="
    if [ ! -e "$CFG" ] && [ ! -L "$CFG" ]; then
        note "no config file, so wpaperd has nothing to draw. Fix: dot-wallpaper init"
    elif [ ! -s "$CFG" ]; then
        note "config file is empty/dangling. Fix: dot-wallpaper init --force"
    else
        sed 's/^/  | /' "$CFG" | head -n 30
        say
        while IFS= read -r p; do
            n="$(count_images "$p")"; total=$((total + n))
            if [ -d "$p" ]; then say "  path $p: folder, $n image(s)"
            elif [ -f "$p" ]; then say "  path $p: a single file"
            else note "path does not exist: $p"; fi
            [ -d "$p" ] && [ "$n" -eq 0 ] && note "folder $p has no images wpaperd can read (jpg, png, webp...)"
        done < <(config_paths | sort -u)
        [ -z "$(config_paths)" ] && note "no 'path =' line in the config"
        if [ "$total" -eq 1 ]; then
            if [ -f "$(config_paths | head -n 1)" ]; then
                say "  - this wallpaper is PINNED (picked in the picker or with 'dot-wallpaper set')."
                say "    next/prev step through $(rotation_folder) ($(count_images "$(rotation_folder)") image(s)); 'dot-wallpaper rotate' resumes automatic rotation."
                [ "$(count_images "$(rotation_folder)")" -lt 2 ] && note "that folder has fewer than 2 images, so there is nothing to step to. Add wallpapers there (or: dot-wallpaper init)"
            else
                note "only ONE image is configured, so 'next wallpaper' has nothing to change to. Add more to the folder (or: dot-wallpaper init)"
            fi
        fi
        exec_line="$(grep -E '^[[:space:]]*exec[[:space:]]*=' "$CFG" | head -1)"
        if [ -z "$exec_line" ]; then
            note "no 'exec =' line: wpaperd never runs matugen-hook.sh, so colours never follow the wallpaper"
        else
            p="$(printf '%s' "$exec_line" | sed -E 's/^[^=]*=[[:space:]]*"?([^"]*)"?.*/\1/; s#^~#'"$HOME"'#')"
            [ -x "$p" ] || note "exec script is missing or not executable: $p"
        fi
    fi

    say; say "== colours =="
    if [ -L "$cache_dir/current-wallpaper" ]; then
        say "  current wallpaper: $(readlink "$cache_dir/current-wallpaper")"
    else
        say "  no ~/.cache/current-wallpaper yet - the hook has never run"
    fi
    if [ -f "$cache_dir/matugen-hook.log" ]; then
        say "  last hook log lines:"; tail -n 6 "$cache_dir/matugen-hook.log" | sed 's/^/  | /'
    fi
    have matugen || note "matugen is not installed"

    say
    if [ "$problems" -eq 0 ]; then
        say "Nothing obviously wrong. If the screen is still black, wpaperd may be failing to draw (VM without 3D acceleration?): run dot-doctor."
    else
        say "$problems problem(s) above. Most are fixed by:  dot-wallpaper init"
    fi
}

# ---------------------------------------------------------------- list / state / set / rotate / theme
is_image() {
    case "${1,,}" in *.jpg|*.jpeg|*.png|*.webp|*.bmp) return 0 ;; *) return 1 ;; esac
}

# The folder whose images we list/rotate: the remembered one while an image is pinned,
# otherwise the first directory in the config, otherwise the default folder.
rotation_folder() {
    local p
    if [ -s "$FOLDER_FILE" ]; then head -n 1 "$FOLDER_FILE"; return; fi
    while IFS= read -r p; do
        if [ -d "$p" ]; then printf '%s\n' "$p"; return; fi
        if [ -f "$p" ]; then printf '%s\n' "$(dirname -- "$p")"; return; fi   # pinned image: its own folder
    done < <(config_paths)
    printf '%s\n' "$WDIR"
}

list_images() {
    local dir; dir="$(rotation_folder)"
    [ -d "$dir" ] || return 0
    find -L "$dir" -maxdepth 1 -type f \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' -o -iname '*.bmp' \) 2>/dev/null | sort
}

theme_value() {   # theme_value KEY default
    local v=""
    [ -r "$THEME_CONF" ] && v="$(sed -n "s/^$1=//p" "$THEME_CONF" | head -n 1)"
    printf '%s\n' "${v:-$2}"
}

state() {
    local cur="" rotating=yes first
    [ -L "$cache_dir/current-wallpaper" ] && cur="$(readlink "$cache_dir/current-wallpaper")"
    first="$(config_paths | head -n 1)"
    [ -n "$first" ] && [ -f "$first" ] && rotating=no
    printf 'current=%s\nrotating=%s\nfolder=%s\nmode=%s\nstyle=%s\n' \
        "$cur" "$rotating" "$(rotation_folder)" "$(theme_value MODE dark)" "$(theme_value STYLE tonal-spot)"
}

# Point every `path =` in [default] and [any] at $1, then restart wpaperd.
write_paths() {
    local value="$1" tmp changed
    [ -s "$CFG" ] || die "no $CFG - run: dot-wallpaper init"
    mkdir -p "$STATE_DIR"
    [ -e "$CFG.dot-backup" ] || cp -L -- "$CFG" "$CFG.dot-backup" 2>/dev/null
    tmp="$(mktemp)" || die "mktemp failed"
    awk -v val="$value" '
        /^[[:space:]]*\[/ { sec = $0; sub(/^[[:space:]]*\[/, "", sec); sub(/\].*$/, "", sec) }
        (sec == "default" || sec == "any") && /^[[:space:]]*path[[:space:]]*=/ { print "path = \"" val "\""; n++; next }
        { print }
        END { exit (n > 0 ? 0 : 3) }
    ' "$CFG" >"$tmp"
    changed=$?
    if [ "$changed" -ne 0 ]; then
        rm -f "$tmp"
        die "your config has no path = line under [default] or [any], so I can't change it safely (edit $CFG by hand)"
    fi
    cat "$tmp" >"$CFG"; rm -f "$tmp"
}

# A wpaperd that is actually alive. `pgrep -x` also matches a process that has died but not been
# reaped yet (a zombie), which made a just-crashed wpaperd look like it was still running.
wpaperd_running() {
    ps -u "$(id -u)" -o stat=,comm= 2>/dev/null | awk '$2 == "wpaperd" && $1 !~ /^Z/ { f = 1 } END { exit !f }'
}
restart_wpaperd() {
    have wpaperd || return 0
    pkill -x wpaperd 2>/dev/null; sleep 0.4
    if [ -n "${WAYLAND_DISPLAY:-}" ]; then setsid -f wpaperd -d >/dev/null 2>&1 </dev/null; fi
}

# Apply a config change to the RUNNING wpaperd. It notices an edited config.toml but does not redraw
# when `path` changes (upstream issue #201: the new image only shows after `wpaperctl next`), which
# is why this script used to kill and restart wpaperd for every change: a new process and a flash each
# time. wpaperd 1.3 can be told directly instead; the restart is kept as the fallback for an older
# wpaperd, a wpaperd that is not running, or a command that fails.
apply_pinned() {      # apply_pinned <image>
    if wpaperd_running && have wpaperctl && wpaperctl set-wallpaper "$1" >/dev/null 2>&1; then
        return 0
    fi
    restart_wpaperd
}
apply_rotation() {
    if wpaperd_running && have wpaperctl; then
        sleep 0.3                      # let wpaperd pick up the edited path first
        wpaperctl next-wallpaper >/dev/null 2>&1 && return 0
    fi
    restart_wpaperd
}
run_hook() {   # re-theme straight away instead of waiting for wpaperd's exec
    [ -x "$HOOK" ] && "$HOOK" manual "$1" >/dev/null 2>&1
}

cmd_set() {
    local img="${1:-}" first
    [ -n "$img" ] || die "usage: dot-wallpaper set <image>"
    img="$(readlink -f -- "$img" 2>/dev/null)"
    [ -f "$img" ] || die "no such file: $1"
    is_image "$img" || die "not an image wpaperd can show (jpg, png, webp, bmp): $img"
    mkdir -p "$STATE_DIR"
    first="$(config_paths | head -n 1)"
    # remember the folder we were rotating through, once
    if [ ! -s "$FOLDER_FILE" ] && [ -d "$first" ]; then printf '%s\n' "$first" >"$FOLDER_FILE"; fi
    write_paths "$img"
    apply_pinned "$img"
    run_hook "$img"
    say "wallpaper set: $(basename "$img")  (pinned - 'dot-wallpaper rotate' resumes rotation)"
}

cmd_rotate() {
    local dir; dir="$(rotation_folder)"
    [ -d "$dir" ] || die "rotation folder $dir does not exist"
    write_paths "$dir"
    apply_rotation
    say "rotating through $dir"
}

cmd_theme() {
    local key val changed=false
    mkdir -p "$STATE_DIR"
    while [ $# -gt 0 ]; do
        key="$1"; val="${2:-}"
        case "$key" in
            mode)
                case "$val" in dark|light) ;; *) die "mode must be dark or light" ;; esac ;;
            style)
                local ok=false st
                for st in "${STYLES[@]}"; do [ "$st" = "$val" ] && ok=true; done
                $ok || die "style must be one of: ${STYLES[*]}" ;;
            *) die "theme: unknown setting '$key' (mode | style)" ;;
        esac
        { grep -v "^${key^^}=" "$THEME_CONF" 2>/dev/null; printf '%s=%s\n' "${key^^}" "$val"; } >"$THEME_CONF.new" && mv -f "$THEME_CONF.new" "$THEME_CONF"
        changed=true
        shift 2
    done
    if $changed && [ -L "$cache_dir/current-wallpaper" ]; then
        run_hook "$(readlink "$cache_dir/current-wallpaper")"
    fi
    say "theme: mode=$(theme_value MODE dark) style=$(theme_value STYLE tonal-spot)"
}

# ---------------------------------------------------------------- init
init() {
    local force=false restart=true a bundle n=0 f
    for a in "$@"; do
        case "$a" in
            --force) force=true ;;
            --no-restart) restart=false ;;
            *) die "init: unknown option $a" ;;
        esac
    done

    mkdir -p "$WDIR" || die "can't create $WDIR"
    n="$(count_images "$WDIR")"
    if [ "$n" -lt 2 ]; then
        if bundle="$(bundle_dir)"; then
            for f in "$bundle"/*; do
                [ -f "$f" ] || continue
                [ -e "$WDIR/$(basename "$f")" ] || cp -- "$f" "$WDIR/"
            done
            say "wallpapers: copied the bundled set into $WDIR ($(count_images "$WDIR") images)"
        else
            warn "$WDIR has $n image(s) and no bundled wallpapers were found - add some yourself"
        fi
    else
        say "wallpapers: $n already in $WDIR"
    fi

    if [ -s "$CFG" ] && ! $force; then
        say "config: kept your existing $CFG (use --force to replace it; the old one is backed up)"
        # Without `exec =` wpaperd never runs the matugen hook, so colours would never
        # follow the wallpaper. Add just that one line (file backed up first).
        if [ -x "$HOOK" ] && ! grep -qE '^[[:space:]]*exec[[:space:]]*=' "$CFG"; then
            if grep -q '^\[default\]' "$CFG"; then
                cp -L -- "$CFG" "$CFG.bak-$(date +%Y%m%d_%H%M%S)"
                sed -i "0,/^\[default\]/s##[default]\nexec = \"$HOOK\"#" "$CFG"
                say "config: added  exec = \"$HOOK\"  under [default] (backup saved)"
            else
                warn "your config has no [default] section; add this line to it yourself:  exec = \"$HOOK\""
            fi
        fi
    else
        mkdir -p "$(dirname "$CFG")"
        if [ -e "$CFG" ] || [ -L "$CFG" ]; then
            cp -L -- "$CFG" "$CFG.bak-$(date +%Y%m%d_%H%M%S)" 2>/dev/null && say "config: old file backed up next to it"
            rm -f -- "$CFG"
        fi
        {
            echo "# Written by dot-wallpaper init. wpaperd reloads this file when it changes."
            echo "[default]"
            echo "path = \"$WDIR\""
            echo "duration = \"30m\""
            echo "sorting = \"random\""
            if [ -x "$HOOK" ]; then echo "exec = \"$HOOK\""; else warn "$HOOK missing - colours won't follow the wallpaper until you run install.sh"; fi
            echo
            echo "[any]"
            echo "path = \"$WDIR\""
        } >"$CFG"
        say "config: wrote $CFG"
    fi

    if $restart && have wpaperd; then
        pkill -x wpaperd 2>/dev/null; sleep 0.4
        if [ -n "${WAYLAND_DISPLAY:-}" ]; then
            setsid -f wpaperd -d >/dev/null 2>&1 </dev/null && say "wpaperd: restarted"
        else
            say "wpaperd: stopped; it starts with Hyprland (not inside a Wayland session here)"
        fi
    fi
}

case "${1:-}" in
    next)   change next-wallpaper ;;
    prev|previous) change previous-wallpaper ;;
    doctor) doctor ;;
    list)   list_images ;;
    state)  state ;;
    set)    shift; cmd_set "$@" ;;
    rotate) cmd_rotate ;;
    theme)  shift; cmd_theme "$@" ;;
    init)   shift; init "$@" ;;
    -h|--help|"") sed -n '2,/^[^#]/{/^#/s/^# \{0,1\}//p}' "${BASH_SOURCE[0]}" ;;
    *) die "unknown command: $1 (see --help)" ;;
esac
