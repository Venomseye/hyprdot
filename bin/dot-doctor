#!/usr/bin/env bash
#
# Diagnose "black screen / no bar / no wallpaper". Read-only: it changes nothing.
#
#   dot-doctor              print a report and save a copy to ~/dot-doctor-<time>.txt
#   dot-doctor --no-save    print only
#   dot-doctor -h           this message
#
# Run it from a terminal INSIDE the broken session (Super+Return). If a
# keybind doesn't work either, switch to a TTY (Ctrl+Alt+F3), log in and run it
# there - the checks that need Hyprland will say so and the rest still work.
# The "Likely problems" list at the end is the part to read first; send the
# whole file if it doesn't explain things.

set -uo pipefail

SAVE=true
case "${1:-}" in
    -h|--help) sed -n '2,/^[^#]/{/^#/s/^# \{0,1\}//p}' "${BASH_SOURCE[0]}"; exit 0 ;;
    --no-save) SAVE=false ;;
esac

config="${XDG_CONFIG_HOME:-$HOME/.config}"
cache="${XDG_CACHE_HOME:-$HOME/.cache}"
OUT="$HOME/dot-doctor-$(date +%Y%m%d_%H%M%S).txt"

issues=()
issue() { issues+=("$*"); }
sec()   { printf '\n== %s ==\n' "$*"; }
have()  { command -v "$1" >/dev/null 2>&1; }
tailf() { # tailf <n> <file>
    if [ -s "$2" ]; then tail -n "$1" "$2" | sed 's/\x1b\[[0-9;]*m//g; s/^/  /'; else echo "  (missing or empty: $2)"; fi
}

report() {
    echo "dot-doctor  $(date -Is)"

    # ------------------------------------------------------------------
    sec "which copy of the dotfiles is installed"
    self="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")"
    repo="$(dirname "$(dirname "$self")")"
    # a normal install COPIES the scripts, so the checkout is gone: the version lives in the share dir
    [ -f "$repo/VERSION" ] || repo="${XDG_DATA_HOME:-$HOME/.local/share}/hyprdot"
    if [ -f "$repo/VERSION" ]; then
        echo "  repo: $repo   version: $(head -n 1 "$repo/VERSION")"
    else
        echo "  repo: $repo   version: unknown (no VERSION file - an older snapshot)"
    fi
    case "$repo/" in
        "$HOME"/Downloads/*|/tmp/*|/var/tmp/*|"$HOME"/.cache/*|/run/*|/dev/shm/*)
            echo "  WARNING: the repo is in a folder that gets cleaned up or moved. Every link in ~/.config and"
            echo "           ~/.local/bin points into it. Move it: mkdir -p ~/.dotfiles && mv \"$repo\" ~/.dotfiles/hyprdot"
            echo "           then run:  bash ~/.dotfiles/hyprdot/install.sh"
            issue "the dotfiles repo ($repo) is in a folder that gets cleaned up; move it somewhere permanent and re-run install.sh"
            ;;
    esac
    if [ -L "${BASH_SOURCE[0]}" ]; then
        echo "  NOTE: this script is a symlink into $repo (an old --link install). Everything in ~/.config and"
        echo "        ~/.local/bin depends on that folder. To switch to independent copies: bash $repo/install.sh"
    fi
    qsd="$(readlink -f "$config/quickshell" 2>/dev/null || true)"
    echo "  ~/.config/quickshell -> ${qsd:-<missing>}"
    for b in dot-theme dot-screenshot dot-clip dot-snippets; do
        [ -e "$repo/bin/$b" ] || echo "  note: $repo/bin/$b does not exist in this copy"
    done

    # ------------------------------------------------------------------
    sec "config check (dot-check --live: installed QML, Hyprland Lua, menu JSON)"
    dc="$(command -v dot-check || true)"; [ -n "$dc" ] || dc="$repo/bin/dot-check"
    if [ -x "$dc" ]; then
        chk="$("$dc" --live 2>&1)"; chk_rc=$?
        printf '%s\n' "$chk" | sed 's/^/  /'
        [ "$chk_rc" -eq 0 ] || issue "dot-check found errors in the installed config - see the 'config check' section; Quickshell/Hyprland may fail to load it"
    else
        echo "  (dot-check not found in this copy of the dotfiles)"
    fi

    # ------------------------------------------------------------------
    sec "session"
    echo "XDG_SESSION_TYPE=${XDG_SESSION_TYPE:-<unset>}  WAYLAND_DISPLAY=${WAYLAND_DISPLAY:-<unset>}  DISPLAY=${DISPLAY:-<unset>}"
    echo "HYPRLAND_INSTANCE_SIGNATURE=${HYPRLAND_INSTANCE_SIGNATURE:-<unset>}"
    echo "QT_QPA_PLATFORM=${QT_QPA_PLATFORM:-<unset>}  QT_QUICK_BACKEND=${QT_QUICK_BACKEND:-<unset>}"
    have Hyprland && Hyprland --version 2>/dev/null | head -1
    virt="$(systemd-detect-virt --vm 2>/dev/null || true)"
    echo "virtualisation: ${virt:-unknown}"
    [ -n "${WAYLAND_DISPLAY:-}" ] || issue "WAYLAND_DISPLAY is not set - this shell isn't inside the Hyprland session"
    case ":$PATH:" in
        *":$HOME/.local/bin:"*) ;;
        *) issue "~/.local/bin is not on PATH, so dot-reload / dot-wallpaper / dot-updates can't be found (the menu says '... is not installed'). Restart Hyprland after updating autostart.lua" ;;
    esac

    # ------------------------------------------------------------------
    sec "graphics access (the screenshot's 'DRM_IOCTL_MODE_CREATE_DUMB ... Permission denied')"
    ls -l /dev/dri/ 2>&1 | sed 's/^/  /'
    echo "  groups: $(id -nG)"
    usable=0
    for n in /dev/dri/renderD*; do
        [ -e "$n" ] && [ -r "$n" ] && [ -w "$n" ] && usable=1
    done
    if [ "$usable" -eq 0 ]; then
        issue "no read/write access to any /dev/dri/renderD* - GL clients (Quickshell, wpaperd) cannot draw. Add yourself to the 'render' and 'video' groups (sudo usermod -aG render,video \$USER, then log out and in), or on a VM enable 3D acceleration"
    fi
    if have eglinfo; then
        eglinfo -B 2>/dev/null | grep -iE 'renderer|vendor|platform' | head -6 | sed 's/^/  /'
    else
        echo "  (eglinfo not installed; 'pacman -S mesa-utils' would show which GL renderer is in use)"
    fi
    if [ "${virt:-none}" != "none" ] && [ -n "${virt:-}" ] && [ "${QT_QUICK_BACKEND:-}" != "software" ]; then
        issue "running in a VM ($virt) but QT_QUICK_BACKEND isn't 'software' - create ~/.config/hypr/software-render and restart Hyprland"
    fi

    # ------------------------------------------------------------------
    sec "packages"
    for pkg in hyprland quickshell matugen wpaperd hyprlock hypridle qt6-wayland qt6-declarative upower mesa; do
        if have pacman; then
            v="$(pacman -Q "$pkg" 2>/dev/null)" && echo "  $v" || echo "  $pkg: NOT INSTALLED"
        fi
    done
    have quickshell || issue "quickshell is not in PATH"
    have wpaperd    || issue "wpaperd is not in PATH"
    have matugen    || issue "matugen is not in PATH"
    if ! ls /usr/lib/qt6/plugins/platforms/libqwayland*.so /usr/lib64/qt6/plugins/platforms/libqwayland*.so >/dev/null 2>&1; then
        issue "Qt Wayland platform plugin not found - install qt6-wayland (Quickshell otherwise falls back to X11 and draws nothing)"
    fi

    # ------------------------------------------------------------------
    sec "processes"
    for p in wpaperd quickshell hypridle mako dunst waybar; do
        pgrep -ax "$p" >/dev/null 2>&1 && pgrep -ax "$p" | sed 's/^/  /' || echo "  $p: not running"
    done
    pgrep -x wpaperd    >/dev/null 2>&1 || issue "wpaperd is not running - no wallpaper (black screen). See the wpaperd section"
    pgrep -x quickshell >/dev/null 2>&1 || issue "quickshell is not running - no bar/menu/notifications. See ~/.cache/quickshell.log below"
    for p in mako dunst; do
        pgrep -x "$p" >/dev/null 2>&1 && issue "$p is running - it owns the notification bus name, so Quickshell can't show notifications. Fix: pkill -x $p; dot-reload shell   (if it comes back by itself, D-Bus is starting it: systemctl --user mask $p.service, or pacman -Rns $p)"
    done
    pgrep -x waybar >/dev/null 2>&1 && issue "waybar is still running next to the Quickshell bar"

    # ------------------------------------------------------------------
    sec "wallpaper (dot-wallpaper doctor)"
    if have dot-wallpaper; then
        dot-wallpaper doctor 2>&1 | sed 's/^/  /'
    elif [ -x "$HOME/.local/bin/dot-wallpaper" ]; then
        "$HOME/.local/bin/dot-wallpaper" doctor 2>&1 | sed 's/^/  /'
    else
        echo "  dot-wallpaper is not installed - run install.sh"
    fi

    sec "wpaperd"
    ls -ld "$config/wpaperd" 2>&1 | sed 's/^/  /'
    ls -l  "$config/wpaperd/" 2>&1 | sed 's/^/  /'
    wcfg="$config/wpaperd/config.toml"
    if [ ! -s "$wcfg" ]; then
        issue "$wcfg is missing, so wpaperd has no wallpaper to draw (black screen). install.sh keeps its originals in ~/.config-backup-*/ - restore with: cp \$(ls -d ~/.config-backup-*/wpaperd/config.toml | tail -1) $wcfg"
        ls -d "$HOME"/.config-backup-* 2>/dev/null | sed 's/^/  backup: /'
    else
        echo "  --- $wcfg"
        head -n 30 "$wcfg" | sed 's/^/  /'
        grep -E '^[[:space:]]*path[[:space:]]*=' "$wcfg" | sed -E 's/^[^=]*=[[:space:]]*"?([^"]*)"?.*/\1/' | while read -r wp; do
            wp="${wp/#\~/$HOME}"
            [ -e "$wp" ] || echo "  !! wallpaper path does not exist: $wp"
        done
        grep -qE '^[[:space:]]*exec[[:space:]]*=' "$wcfg" || echo "  note: no 'exec =' line - matugen-hook.sh is never called, so colours never update"
    fi

    # ------------------------------------------------------------------
    sec "Hyprland"
    if have hyprctl && [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then
        errs="$(hyprctl configerrors 2>&1)"
        if [ -n "$errs" ]; then echo "  config errors:"; printf '%s\n' "$errs" | sed 's/^/    /'; issue "Hyprland reports config errors (above)"; else echo "  hyprctl configerrors: none"; fi
        echo "  --- last warnings/errors in Hyprland's log"
        hyprctl rollinglog 2>/dev/null | grep -iE 'err|warn|fail|lua|permission' | tail -n 25 | sed 's/^/  /'
    else
        echo "  (not inside a Hyprland session - skipped)"
    fi
    for d in hypr quickshell hooks matugen wpaperd kitty ghostty gtk-3.0 gtk-4.0 xcompose; do
        [ -d "$config/$d" ] || continue
        while IFS= read -r l; do
            echo "  dangling link: $l"
            issue "dangling link $l (a file was removed from the repo - rerun install.sh)"
        done < <(find "$config/$d" -xtype l 2>/dev/null | head -5)
    done
    while IFS= read -r l; do echo "  dangling link: $l"; done < <(find "$HOME/.local/bin" -maxdepth 1 -xtype l 2>/dev/null)

    # ------------------------------------------------------------------
    sec "Quickshell"
    ls "$config/quickshell" 2>&1 | sed 's/^/  /'
    [ -e "$config/quickshell/shell.qml" ] || issue "$config/quickshell/shell.qml is missing - Quickshell has nothing to load"
    if grep -q BOOTSTRAP "$config/quickshell/theme/Colors.qml" 2>/dev/null; then
        echo "  Colors.qml: still the bootstrap placeholder (matugen hasn't run yet) - harmless, the bar still works"
    elif [ -e "$config/quickshell/theme/Colors.qml" ]; then
        echo "  Colors.qml: generated by matugen"
    else
        issue "theme/Colors.qml is missing - every QML file imports it"
    fi
    echo "  --- $cache/quickshell.log (last 40 lines)"
    tailf 40 "$cache/quickshell.log"
    if have qs && pgrep -x quickshell >/dev/null 2>&1; then
        echo "  --- qs log (last 30 lines)"
        timeout 5 qs log 2>&1 | tail -n 30 | sed 's/^/  /'
    fi
    # Only the CURRENT run counts: the log is appended to forever, so errors from before you fixed
    # something would otherwise be reported on every future doctor run.
    qslog_now="$(awk '/Launching config/ { n = NR } { l[NR] = $0 } END { for (i = (n ? n : 1); i <= NR; i++) print l[i] }' "$cache/quickshell.log" 2>/dev/null)"
    if printf '%s\n' "$qslog_now" | grep -qiE 'could not find the qt platform plugin|no qt platform plugin|xcb|eglfs|DRM_IOCTL_MODE_CREATE_DUMB'; then
        issue "quickshell.log shows a Qt platform / DRM problem - see the graphics-access and qt6-wayland checks above"
    fi
    if printf '%s\n' "$qslog_now" | sed 's/\x1b\[[0-9;]*m//g' \
        | grep -iE 'error|failed to load|unavailable|is not a type|not installed|cannot assign' \
        | grep -viE 'NoActivePlayer|playerctld|File does not exist|Reloading|host portal|page-flip' | grep -q .; then
        issue "quickshell.log (since the last start) contains real errors - see the section above and send it"
    fi
    echo "  (playerctld 'NoActivePlayer' and 'File does not exist' warnings are harmless)"

    # ------------------------------------------------------------------
    sec "theming (why some apps stay light)"
    if have dot-theme; then dot-theme doctor 2>&1 | sed 's/^/  /'
    elif [ -x "$HOME/.local/bin/dot-theme" ]; then "$HOME/.local/bin/dot-theme" doctor 2>&1 | sed 's/^/  /'
    else echo "  dot-theme is not installed - run install.sh"; fi

    sec "keyboard (Compose key / Right Alt)"
    if have dot-restart-xcompose; then
        dot-restart-xcompose --check 2>&1 | sed 's/^/  /'
    elif [ -x "$HOME/.local/bin/dot-restart-xcompose" ]; then
        "$HOME/.local/bin/dot-restart-xcompose" --check 2>&1 | sed 's/^/  /'
    else
        echo "  dot-restart-xcompose is not installed - run install.sh"
    fi

    sec "keybinds"
    if have hyprctl && [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then
        nb="$(hyprctl binds -j 2>/dev/null | grep -c '"key"')"
        echo "  Hyprland has $nb keybinds registered"
        [ "${nb:-0}" -gt 5 ] || issue "only ${nb:-0} keybinds are registered - bindings.lua failed to load (hyprctl configerrors above)"
        hyprctl submap 2>/dev/null | sed 's/^/  active submap: /'
    else
        echo "  (not inside a Hyprland session - skipped)"
    fi

    sec "windows (class / title / floating / size - what rules.lua matches against)"
    if have hyprctl && have jq && [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then
        hyprctl clients -j 2>/dev/null | jq -r '.[] | "  class=\(.class)  floating=\(.floating)  size=\(.size[0])x\(.size[1])  title=\(.title[0:60])"'
        echo "  (a file dialog's class only shows while it is open: run  sleep 5; dot-doctor  and open the dialog)"
    else
        echo "  (needs hyprctl and jq inside a Hyprland session - skipped)"
    fi

    sec "power & suspend (a suspended machine should draw almost nothing)"
    echo "  suspend modes: $(cat /sys/power/mem_sleep 2>/dev/null || echo unknown)   <- the one in [brackets] is used; s2idle (\"modern standby\") drains far more than deep"
    for k in success fail last_failed_dev last_hw_sleep total_hw_sleep max_hw_sleep; do
        [ -r "/sys/power/suspend_stats/$k" ] && printf '  suspend_stats/%s = %s\n' "$k" "$(cat "/sys/power/suspend_stats/$k")"
    done
    grep -hsE '^[[:space:]]*Handle(LidSwitch|LidSwitchExternalPower|LidSwitchDocked|PowerKey|SuspendKey)=' /etc/systemd/logind.conf /etc/systemd/logind.conf.d/*.conf 2>/dev/null | sed 's/^/  logind: /'
    for b in /sys/class/power_supply/BAT*; do
        [ -r "$b/capacity" ] || continue
        pw="$(cat "$b/power_now" 2>/dev/null || echo 0)"
        printf '  %s: %s%% %s, drawing %s W right now\n' "$(basename "$b")" "$(cat "$b/capacity")" "$(cat "$b/status" 2>/dev/null)" "$(awk -v p="$pw" 'BEGIN { printf "%.1f", p / 1000000 }')"
    done
    for c in /sys/class/drm/card[0-9]; do
        d="$c/device"
        [ -d "$d" ] || continue
        printf '  %s: pci %s:%s driver=%s runtime_pm=%s power_state=%s\n' "$(basename "$c")" "$(cat "$d/vendor" 2>/dev/null)" "$(cat "$d/device" 2>/dev/null)" \
            "$(basename "$(readlink -f "$d/driver" 2>/dev/null)")" "$(cat "$d/power/runtime_status" 2>/dev/null || echo ?)" "$(cat "$d/power_state" 2>/dev/null || echo ?)"
    done
    if have systemd-inhibit; then
        echo "  inhibitors (things that can stop idle/sleep):"
        systemd-inhibit --list --no-pager 2>/dev/null | head -n 12 | sed 's/^/    /'
    fi
    echo "  busiest processes right now:"
    ps -eo pid=,pcpu=,pmem=,comm= --sort=-pcpu 2>/dev/null | head -n 6 | sed 's/^/    /'
    dsl="$(command -v dot-sleep-log || true)"; [ -n "$dsl" ] || dsl="$repo/bin/dot-sleep-log"
    if [ -x "$dsl" ]; then
        echo "  suspend history (dot-sleep-log):"
        sl="$("$dsl" report 5 2>&1)"
        printf '%s\n' "$sl" | sed 's/^/    /'
        avg="$(printf '%s\n' "$sl" | sed -n 's/^average over .*: \([0-9.]*\) %\/h$/\1/p')"
        if [ -n "$avg" ] && awk -v a="$avg" 'BEGIN { exit !(a > 2.0) }'; then
            issue "suspend costs ${avg} %/h of battery (a healthy suspend is well under 1 %/h). Check the 'power & suspend' section: mem_sleep, suspend_stats hw_sleep, the GPU's runtime_pm, inhibitors"
        fi
    fi

    sec "bluetooth / network hardware (why a Quick settings tile may be missing)"
    if have bluetoothctl; then echo "  bluetoothctl: $(command -v bluetoothctl)"; else echo "  bluetoothctl: NOT INSTALLED (pacman -S bluez-utils)"; fi
    bt_adapters="$(ls /sys/class/bluetooth 2>/dev/null | grep -c '^hci' || true)"
    echo "  adapters the kernel sees (/sys/class/bluetooth): ${bt_adapters:-0}"
    if have systemctl; then
        echo "  bluetooth.service: $(systemctl is-active bluetooth 2>/dev/null || true) (enabled: $(systemctl is-enabled bluetooth 2>/dev/null || true))"
    fi
    if have rfkill; then rfkill list bluetooth 2>/dev/null | sed 's/^/  rfkill: /'; fi
    if have bluetoothctl; then
        echo "  bluetoothctl list: $(timeout 5 bluetoothctl list 2>&1 | head -n 2 | tr '\n' ' ')"
    fi
    if [ "${bt_adapters:-0}" -eq 0 ]; then
        echo "  -> no Bluetooth adapter: no Bluetooth tile or bar icon is expected (a VM usually has none; for"
        echo "     a USB adapter pass it through to the VM)"
    elif ! have bluetoothctl; then
        issue "a Bluetooth adapter exists but bluetoothctl is not installed: pacman -S bluez bluez-utils"
    elif [ "$(systemctl is-active bluetooth 2>/dev/null)" != active ]; then
        issue "a Bluetooth adapter exists but bluetooth.service is not running, so the tile stays hidden: sudo systemctl enable --now bluetooth"
    fi
    if have nmcli; then
        echo "  network devices (nmcli):"
        nmcli -t -f TYPE,STATE,DEVICE device 2>/dev/null | sed 's/^/    /'
        nmcli -t -f TYPE device 2>/dev/null | grep -qx wifi || echo "  -> no Wi-Fi adapter: the Wi-Fi tile is replaced by an Ethernet tile"
    fi

    sec "menu commands (everything the menu can run)"
    mj="$config/quickshell/menu/menu.json"
    if [ -r "$mj" ]; then
        if have jq; then
            acts="$(jq -r '.. | objects | select(.action) | .action' "$mj" 2>/dev/null)"
        else
            acts="$(grep -oE '"action": *"[^"]*"' "$mj" | sed -E 's/^"action": *"//; s/"$//')"
        fi
        while IFS= read -r c; do
            [ -n "$c" ] || continue
            if PATH="$HOME/.local/bin:$PATH" command -v "$c" >/dev/null 2>&1; then echo "  ok       $c"
            else echo "  MISSING  $c"; issue "menu runs '$c' but it isn't installed / on PATH"; fi
        done < <(printf '%s\n' "$acts" | awk '{print $1}' | sort -u)
        for c in grim slurp satty wl-copy notify-send kitty wpaperctl hyprctl qs hyprshutdown; do
            have "$c" || echo "  optional: $c not installed (some menu entries fall back or report it)"
        done
    else
        echo "  $mj not found"
    fi

    sec "failed services (the [FAILED] lines you see on the console after logging out)"
    if have systemctl; then
        sysfail="$(systemctl --failed --no-legend --plain 2>/dev/null | awk '{print $1}')"
        usrfail="$(systemctl --user --failed --no-legend --plain 2>/dev/null | awk '{print $1}')"
        if [ -z "$sysfail$usrfail" ]; then
            echo "  none"
        else
            [ -n "$sysfail" ] && printf '  system: %s\n' "$(echo $sysfail)"
            [ -n "$usrfail" ] && printf '  user:   %s\n' "$(echo $usrfail)"
            issue "failed services: $(echo $sysfail $usrfail). See each with: systemctl status <name>; disable ones you don't use: sudo systemctl disable --now <name>"
            echo "$sysfail" | grep -qx 'samba.service' && issue "samba.service (\"Samba AD Daemon\") fails at boot - it only makes sense on a domain controller. Fix: sudo systemctl disable --now samba   (file sharing uses smb/nmb, not this)"
        fi
    else
        echo "  systemctl not found"
    fi

    sec "hook logs"
    echo "  --- matugen-hook.log"; tailf 12 "$cache/matugen-hook.log"
    echo "  --- hooks.log";        tailf 12 "$cache/hooks.log"

    # ------------------------------------------------------------------
    sec "Likely problems"
    if [ "${#issues[@]}" -eq 0 ]; then
        echo "  none of the automatic checks tripped - send this whole file"
    else
        i=1
        for m in "${issues[@]}"; do echo "  $i. $m"; i=$((i + 1)); done
    fi
}

if $SAVE; then
    report 2>&1 | tee "$OUT"
    echo; echo "saved: $OUT"
else
    report 2>&1
fi
