#!/usr/bin/env bash
#
# Regenerate ~/.XCompose from the template, then nudge the input method.
#
#   dot-restart-xcompose [options]
#
#   -n, --dry-run    show the diff and what would happen, change nothing
#       --no-restart write the file but don't touch fcitx5/ibus
#       --check      diagnose "the Compose key does nothing": is the key set in Hyprland,
#                    is there a Compose table for your locale, what is in ~/.XCompose
#   -h, --help       this message
#
# Template, first match wins:
#   $XCOMPOSE_TEMPLATE
#   ~/.config/xcompose/XCompose.template
#   <this repo>/config/xcompose/XCompose.template
# Values for @PLACEHOLDERS@ come from ~/.config/xcompose/vars (KEY=value lines,
# parsed, never sourced). Your own extra sequences can go in
# ~/.config/xcompose/extra.compose; if it exists it is appended (and may use
# the same @PLACEHOLDERS@), so personal snippets never touch the repo. A template line whose placeholder has no value is
# dropped with a warning, so an unset EMAIL can't expand to nothing.
#
# `include "%L"` in the template (the system's own sequences for your locale) is
# replaced by the explicit file path, found via LC_ALL/LC_CTYPE/LANG and X11's
# compose.dir. If your locale has no Compose file the include is dropped, so your own
# sequences still load instead of the whole table being rejected.
#
# Why "restart" is approximate: there is no global "reload compose tables".
# Toolkits (GTK, Qt, libxkbcommon clients like kitty) read ~/.XCompose when an
# app or its input context starts. If fcitx5 or ibus is your input method,
# restarting it refreshes apps that go through it; everything else picks the
# new file up the next time you open it.
# The Compose key itself is set in hypr/input.lua (kb_options = "compose:ralt").

set -uo pipefail
# bash 5.2 makes `&` special in ${var//x/y} replacements; values here are data.
shopt -u patsub_replacement 2>/dev/null || true

DRY_RUN=false
RESTART=true
CHECK=false
for arg in "$@"; do
    case "$arg" in
        -n|--dry-run) DRY_RUN=true ;;
        --no-restart) RESTART=false ;;
        --check) CHECK=true ;;
        -h|--help)
            sed -n '2,/^[^#]/{/^#/s/^# \{0,1\}//p}' "${BASH_SOURCE[0]}"
            exit 0
            ;;
        *) echo "dot-restart-xcompose: unknown argument: $arg (see --help)" >&2; exit 2 ;;
    esac
done

config_dir="${XDG_CONFIG_HOME:-$HOME/.config}"
script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TARGET="$HOME/.XCompose"
VARS_FILE="$config_dir/xcompose/vars"
EXTRA_FILE="$config_dir/xcompose/extra.compose"
MARKER="# GENERATED by dot-restart-xcompose"

say()  { printf '%s\n' "$*"; }
warn() { printf 'warn: %s\n' "$*" >&2; }
err()  { printf 'error: %s\n' "$*" >&2; }

# ---- the system Compose file for this locale (what `include "%L"` means)
locale_name() {
    local l="${LC_ALL:-${LC_CTYPE:-${LANG:-}}}"
    printf '%s' "${l:-en_US.UTF-8}"
}

resolve_locale_compose() {
    local dir=/usr/share/X11/locale loc cand rel
    loc="$(locale_name)"
    # compose.dir maps locale names to the directory holding their Compose file
    if [ -r "$dir/compose.dir" ]; then
        rel="$(awk -v l="$loc" '!/^#/ && $2 == l { sub(":", "", $1); print $1; exit }' "$dir/compose.dir")"
        [ -n "$rel" ] && [ -f "$dir/$rel" ] && { printf '%s\n' "$dir/$rel"; return 0; }
    fi
    for cand in "$loc" "${loc%%.*}.UTF-8" en_US.UTF-8; do
        [ -f "$dir/$cand/Compose" ] && { printf '%s\n' "$dir/$cand/Compose"; return 0; }
    done
    return 1
}

# ---- --check
if $CHECK; then
    expected="compose:ralt"
    [ -r "$config_dir/hypr/compose-key" ] && expected="$(head -n 1 "$config_dir/hypr/compose-key")"
    echo "== Compose key =="
    echo "  expected option: $expected   (set by hypr/input.lua; change with: echo compose:rctrl > ~/.config/hypr/compose-key)"
    if command -v hyprctl >/dev/null 2>&1 && [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then
        got="$(hyprctl getoption input:kb_options -j 2>/dev/null | sed -n 's/.*"str"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -1)"
        echo "  Hyprland has:    ${got:-<empty - kb_options is not set>}"
        case ",${got}," in
            *",$expected,"*|*"$expected"*) echo "  -> OK: the option is applied" ;;
            *) echo "  -> NOT APPLIED. Restart Hyprland (a reload does not always re-create the keyboard)." ;;
        esac
        if command -v jq >/dev/null 2>&1; then
            hyprctl devices -j 2>/dev/null | jq -r '.keyboards[]? | "  keyboard: \(.name)  layout=\(.layout) options=[\(.options)] active=\(.active_keymap)"' 2>/dev/null
        fi
    else
        echo "  (not inside a Hyprland session - can't read the live setting)"
    fi
    echo
    echo "== Locale =="
    echo "  LC_ALL=${LC_ALL:-} LC_CTYPE=${LC_CTYPE:-} LANG=${LANG:-}"
    if sysc="$(resolve_locale_compose)"; then echo "  system Compose table: $sysc"
    else echo "  system Compose table: NOT FOUND for '$(locale_name)' (the default sequences will be left out; yours still work)"; fi
    echo
    echo "== $TARGET =="
    if [ -f "$TARGET" ]; then
        echo "  $(grep -cE '^<' "$TARGET") sequences; first lines:"; head -n 4 "$TARGET" | sed 's/^/    /'
        grep -qF '# GENERATED by dot-restart-xcompose' "$TARGET" || echo "  note: not generated by this script (hand-written)"
    else
        echo "  missing - run dot-restart-xcompose"
    fi
    echo
    echo "== Test it =="
    echo "  1. wev   (pacman -S wev), press Right Alt. The line should say  sym: Multi_key."
    echo "       sym Alt_R       -> the option is not applied: restart Hyprland."
    echo "       no event at all -> the key never reaches this session (a VM viewer may grab it:"
    echo "                          try compose:rctrl or compose:menu in ~/.config/hypr/compose-key)."
    echo "  2. Open a NEW terminal (apps read ~/.XCompose when they start), press and release"
    echo "     Right Alt, then type:  m a i l"
    echo "  3. Still nothing in some app? Use Super+Space -> Snippets: it copies the text to the"
    echo "     clipboard, which works everywhere, no keyboard setup needed."
    exit 0
fi

# ---- find the template
template=""
for c in "${XCOMPOSE_TEMPLATE:-}" "$config_dir/xcompose/XCompose.template" "$script_dir/../config/xcompose/XCompose.template"; do
    if [ -n "$c" ] && [ -f "$c" ]; then template="$c"; break; fi
done
[ -n "$template" ] || { err "no XCompose.template found (looked in $config_dir/xcompose/ and the repo)"; exit 1; }

# ---- read variables
declare -A VARS=()
if [ -f "$VARS_FILE" ]; then
    n=0
    while IFS= read -r line || [ -n "$line" ]; do
        n=$((n + 1))
        case "$line" in ''|\#*) continue ;; esac
        key="${line%%=*}"
        val="${line#*=}"
        if [[ "$line" != *=* ]] || ! [[ "$key" =~ ^[A-Z][A-Z0-9_]*$ ]]; then
            warn "$VARS_FILE:$n ignored (expected KEY=value with KEY in CAPS)"
            continue
        fi
        if [[ ${#val} -ge 2 && ( "$val" == \"*\" || "$val" == \'*\' ) ]]; then
            val="${val:1:${#val}-2}"
        fi
        VARS["$key"]="$val"
    done <"$VARS_FILE"
else
    warn "no $VARS_FILE - every line using a @PLACEHOLDER@ will be dropped (see vars.example)"
fi

# ---- render. Sets RENDERED (text) and SKIP (1 if a placeholder had no value).
render_line() {
    local rest="$1" out="" name pre val
    SKIP=0
    while [[ "$rest" =~ @([A-Z][A-Z0-9_]*)@ ]]; do
        name="${BASH_REMATCH[1]}"
        pre="${rest%%@${name}@*}"
        rest="${rest#*@${name}@}"
        val="${VARS[$name]:-}"
        if [ -z "$val" ]; then
            SKIP=1
            warn "dropping a line: $name is not set"
        fi
        # XCompose strings: backslash and double quote must be escaped.
        val="${val//\\/\\\\}"
        val="${val//\"/\\\"}"
        out+="$pre$val"
    done
    RENDERED="$out$rest"
}

if sysc="$(resolve_locale_compose)"; then
    LOCALE_INCLUDE="include \"$sysc\""
else
    LOCALE_INCLUDE="# no system Compose table found for locale '$(locale_name)': default sequences omitted"
    warn "no system Compose table for '$(locale_name)' - only your own sequences will work (run --check)"
fi

tmp="$(mktemp "${TMPDIR:-/tmp}/xcompose.XXXXXX")" || { err "mktemp failed"; exit 1; }
trap 'rm -f "$tmp"' EXIT

{
    printf '%s from %s - do not edit, edit the template.\n' "$MARKER" "$template"
    while IFS= read -r line || [ -n "$line" ]; do
        case "$line" in
            'include "%L"') printf '%s\n' "$LOCALE_INCLUDE"; continue ;;
        esac
        # Comment lines pass through untouched: they may mention @PLACEHOLDER@
        # purely as documentation.
        case "$line" in
            \#*|'') printf '%s\n' "$line"; continue ;;
        esac
        render_line "$line"
        [ "$SKIP" -eq 0 ] && printf '%s\n' "$RENDERED"
    done < <(
        cat -- "$template"
        if [ -f "$EXTRA_FILE" ]; then
            printf '\n# ---- %s ----\n' "$EXTRA_FILE"
            cat -- "$EXTRA_FILE"
        fi
    )
} >"$tmp"

# ---- lint: refuse to install something the parser would choke on
bad=0
ln=0
while IFS= read -r line; do
    ln=$((ln + 1))
    case "$line" in ''|\#*|include\ *) continue ;; esac
    if [[ "$line" != \<* || "$line" != *:* || "$line" != *\"* ]]; then
        err "rendered line $ln is not a valid compose rule: $line"
        bad=1
    fi
done <"$tmp"
[ "$bad" -eq 0 ] || { err "not installing - fix the template"; exit 1; }

# ---- install
if [ -f "$TARGET" ] && cmp -s "$tmp" "$TARGET"; then
    say "$TARGET: unchanged"
else
    if [ -f "$TARGET" ] && ! grep -qF "$MARKER" "$TARGET"; then
        backup="$TARGET.bak-$(date +%Y%m%d-%H%M%S)"
        if $DRY_RUN; then
            say "would back up your hand-written $TARGET -> $backup"
        else
            cp -a "$TARGET" "$backup" && say "backed up your existing file -> $backup"
        fi
    fi
    if $DRY_RUN; then
        say "=== DRY RUN - diff ($TARGET -> new) ==="
        diff -u "$TARGET" "$tmp" 2>/dev/null || cat "$tmp"
    else
        cp "$tmp" "$TARGET.new" && mv -f "$TARGET.new" "$TARGET"
        say "$TARGET: written"
    fi
fi

# ---- nudge the input method
$RESTART || exit 0

uid="$(id -u)"
if pgrep -u "$uid" -x fcitx5 >/dev/null 2>&1; then
    if $DRY_RUN; then say "would: fcitx5 -d -r   (replace the running instance)"
    else fcitx5 -d -r >/dev/null 2>&1 && say "fcitx5: restarted"; fi
elif pgrep -u "$uid" -x ibus-daemon >/dev/null 2>&1; then
    if $DRY_RUN; then say "would: ibus restart"
    else ibus restart >/dev/null 2>&1 && say "ibus: restarted"; fi
else
    say "no fcitx5/ibus running: apps read ~/.XCompose when they start - reopen any app that should pick it up"
fi
