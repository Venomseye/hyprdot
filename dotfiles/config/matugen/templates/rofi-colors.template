/* Generated by matugen from the current wallpaper. Do not edit by hand.
 *
 * This file is pulled in with `?import` (NOT `@theme`) from config.rasi.
 * @theme discards whatever theme is already loaded; @import merges into it.
 * Using @theme here is what was silently deleting the spotlight-dark theme.
 */
* {
    background-color: {{colors.background.default.hex}};
    text-color:       {{colors.on_surface.default.hex}};
}

window {
    background-color: {{colors.background.default.hex}};
    border-color:     {{colors.primary.default.hex}};
}

element selected {
    background-color: {{colors.primary.default.hex}};
    text-color:       {{colors.on_primary.default.hex}};
}

element-text, element-icon {
    text-color: inherit;
}

inputbar {
    text-color: {{colors.on_surface.default.hex}};
}

entry {
    placeholder-color: {{colors.outline.default.hex}};
}
