font=JetBrainsMono Nerd Font 11
width=320
height=110
margin=10
padding=10
border-size=2
border-radius=8

default-timeout=5000
ignore-timeout=1
layer=overlay
anchor=top-right

# Middle-click a notification to get an action menu, right-click to dismiss.
# Syntax matches the documented example exactly (man mako 5), just swapping
# their dmenu for rofi's dmenu-compatible mode - no "--" separator, since
# makoctl menu doesn't expect one and the man page's own example doesn't use it.
on-button-middle=exec makoctl menu -n "$id" rofi -dmenu -p 'Action: '

# Colours are generated by matugen from the current wallpaper.
# Do not hardcode colours below this line - edit
# ~/.config/matugen/templates/mako-colors.template instead.
#
# ORDERING MATTERS: the included file opens [urgency=...] sections of its own.
# Everything above is global because it comes BEFORE this include; anything
# you add AFTER it would silently land inside the last section the included
# file opened.
include=~/.config/mako/mako-colors

# Critical notifications never expire.
[urgency=high]
default-timeout=0

# A "do not disturb" mode. Toggle with:  makoctl mode -t do-not-disturb
[mode=do-not-disturb]
invisible=1
