# ghostty - part of hyprdot. Colours come from matugen (colors-matugen, last line).

font-family = JetBrainsMono Nerd Font
font-size = 11

window-padding-x = 10
window-padding-y = 10
background-opacity = 0.88
gtk-titlebar = false

cursor-style = bar
cursor-style-blink = false
mouse-hide-while-typing = true
copy-on-select = clipboard
shell-integration = detect

# Closing a window never asks "are you sure?" (Super+Q), even with a program running.
confirm-close-surface = false

config-file = ?colors-matugen
