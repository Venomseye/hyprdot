pragma Singleton

import QtQuick
import Quickshell

// Layout constants shared by every component. Colours live in Colors.qml
// (generated by matugen) - never put a hex value anywhere else.
Singleton {
    readonly property string fontFamily: "JetBrainsMono Nerd Font"
    readonly property int fontSize: 14
    readonly property int iconSize: 16     // bar glyphs
    readonly property int iconBox: 20      // every bar glyph is centred in a box this wide, so gaps are even

    // Bar height. 26 looked tiny next to 2px window borders and 10px gaps; 34 fits 14px
    // text with room to breathe. Lower it (30) for a slimmer bar.
    readonly property int barHeight: 34
    // Panels (calendar, toasts, OSD) match your Hyprland window rounding;
    // the menu uses the 12px you asked for.
    readonly property int radius: 10
    readonly property int menuRadius: 12
    readonly property int gap: 10   // = Hyprland gaps_out, so panels line up with windows

    // Panels are slightly see-through (real blur needs the layer rule at the end of
    // hypr/rules.lua), and fade/slide in over animMs.
    readonly property real panelOpacity: 0.9
    readonly property int animMs: 140

    // Log out / Reboot / Shut down ask for a second Enter (or a second click) before running.
    // Set to false to run them on the first one.
    readonly property bool confirmPower: true

    // Things that close themselves (milliseconds of no activity).
    readonly property int menuIdleMs: 30000      // menu
    readonly property int popupIdleMs: 15000     // calendar, notification history
    readonly property int panelIdleMs: 20000     // quick settings / wallpaper picker once the pointer has left
    readonly property int toastMs: 5000          // normal notification
    readonly property int toastCriticalMs: 12000 // critical ones disappear too, just later

    // Colour temperature the night-light toggle applies (hyprsunset -t).
    readonly property int nightLightKelvin: 4000

    readonly property string configHome: Quickshell.env("XDG_CONFIG_HOME") || (Quickshell.env("HOME") + "/.config")
    readonly property string stateHome: Quickshell.env("XDG_STATE_HOME") || (Quickshell.env("HOME") + "/.local/state")
}
