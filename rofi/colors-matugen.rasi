/* Generated by matugen from the current wallpaper. Do not edit by hand.
 *
 * Pulled in with `?import` (NOT `@theme`) from config.rasi.
 * @theme discards whatever theme is already loaded; @import merges into it.
 */
* {
    background-color: #18181b;
    text-color:       #ffffff;
}

window {
    background-color: #18181b;
    border-color:     #75f1fa;
}

element selected {
    background-color: #75f1fa;
    text-color:       #000000;
}

element-text, element-icon {
    text-color: inherit;
}

inputbar {
    text-color: #ffffff;
}

entry {
    placeholder-color: #71717a;
}
